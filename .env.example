# ==========================================
# RailModern (BharatRail) Environment Variables
# ==========================================

# Server & Node Configuration
NODE_ENV=production
PORT=3000
NEXT_PUBLIC_APP_URL=https://railmodern.vercel.app

# Database Connection (Supabase PostgreSQL / MongoDB Atlas)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres
# OR MONGODB_URI=mongodb+srv://admin:[PASSWORD]@cluster0.mongodb.net/railmodern?retryWrites=true&w=majority

# JWT Secret for Session & Tokens
JWT_SECRET=super_secret_jwt_key_railmodern_2026_indian_railways
JWT_EXPIRES_IN=7d

# RapidAPI / Indian Railways Live Data API (Optional external sync)
RAPIDAPI_KEY=your_rapidapi_indian_railways_key
RAPIDAPI_HOST=irctc1.p.rapidapi.com

# Payment Gateway Keys (Razorpay / Cashfree / Stripe Simulation)
RAZORPAY_KEY_ID=rzp_live_sample_key
RAZORPAY_KEY_SECRET=rzp_live_sample_secret

# CRIS / PRS Sandbox Gateway Endpoint
PRS_GATEWAY_URL=https://mock-prs.indianrailways.gov.in/api/v1
